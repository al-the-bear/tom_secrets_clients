{
  "language": "typescript",
  "toolchain": ["node", "--version"],
  "build": [
    ["npm", "ci", "--prefix", "../clients/typescript"],
    ["npm", "run", "build", "--prefix", "../clients/typescript"],
    ["node", "../clients/typescript/node_modules/typescript/bin/tsc", "-p", "runners/typescript/tsconfig.json"]
  ],
  "run": ["node", "runners/typescript/build/runner.js"],
  "actions": ["connect", "get", "getMany", "getFile", "parse", "format", "concurrent", "sequence"]
}
