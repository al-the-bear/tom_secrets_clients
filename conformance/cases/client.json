  {
   "name": "hello names the client; welcome is read",
   "script": {},
   "action": {
    "do": "connect"
   },
   "expect": {
    "result": {
     "welcome": {
      "host": "conformance-host",
      "platform": "linux",
      "features": []
     }
    },
    "sent": [
     {
      "op": "hello",
      "protocol": 1,
      "client": {
       "name": "conformance-runner",
       "version": "$any",
       "language": "$any"
      },
      "clientToken": "$absent"
     }
    ],
    "connections": 1
   }
  },
  {
   "name": "unknown welcome members are ignored; features are read",
   "script": {
    "welcome": {
     "features": [
      "getFile",
      "binary"
     ],
     "platform": "macos",
     "futureMember": {
      "nested": [
       1,
       2
      ]
     }
    }
   },
   "action": {
    "do": "connect"
   },
   "expect": {
    "result": {
     "welcome": {
      "host": "conformance-host",
      "platform": "macos",
      "features": [
       "binary",
       "getFile"
      ]
     }
    }
   }
  },
