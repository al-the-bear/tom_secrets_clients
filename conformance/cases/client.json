   "action": {
    "do": "get",
    "ref": "db.main"
   },
   "expect": {
    "result": {
     "error": {
      "kind": "not_running"
     }
    }
   }
  },
  {
   "name": "an unsupported protocol: unsupported",
   "script": {
    "hello": [
     {
      "send": {
       "op": "error",
       "kind": "unsupported",
       "message": "protocol 1 is not spoken",
       "details": {
        "protocols": [
         2
        ]
       }
      }
     },
     {
      "close": true
     }
    ]
   },
   "action": {
    "do": "connect"
   },
   "expect": {
    "result": {
     "error": {
      "kind": "unsupported"
     }
    }
   }
  },
  {
   "name": "a welcome of another protocol: unsupported",
   "script": {
    "welcome": {
     "protocol": 2
    }
   },
   "action": {
    "do": "connect"
   },
   "expect": {
    "result": {
     "error": {
      "kind": "unsupported"
     }
    }
   }
  },
  {
   "name": "a refused hello: denied, bad_token",
   "script": {
    "hello": [
     {
      "send": {
       "op": "error",
       "kind": "denied",
       "message": "wrong token",
       "details": {
        "reason": "bad_token"
       }
      }
     },
     {
      "close": true
     }
    ]
   },
   "action": {
    "do": "connect"
   },
   "expect": {
    "result": {
     "error": {
      "kind": "denied",
      "reason": "bad_token"
     }
    }
   }
  },
  {
   "name": "a connection dropped while a request waits: not_running",
   "script": {
    "rules": [
     {
      "match": {
       "op": "get"
      },
      "reply": [
       {
        "close": true
       }
      ]
     }
    ]
   },
   "action": {
    "do": "get",
    "ref": "db.main"
   },
   "expect": {
    "result": {
     "error": {
      "kind": "not_running"
     }
    }
   }
  },
