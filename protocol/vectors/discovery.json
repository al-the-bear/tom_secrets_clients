{
 "note": "Where a library looks for the service (section 3): per OS, environment and uid. A missing socket or port file there is not_running. Port files with the port each yields, or null when the file is unreadable (not_running).",
 "cases": [
  {
   "os": "linux",
   "env": {
    "XDG_RUNTIME_DIR": "/run/user/1000"
   },
   "uid": 1000,
   "expect": {
    "directory": "/run/user/1000/tsm",
    "client": {
     "socket": "/run/user/1000/tsm/client.sock"
    },
    "admin": {
     "socket": "/run/user/1000/tsm/admin.sock"
    }
   }
  },
  {
   "os": "linux",
   "env": {
    "XDG_RUNTIME_DIR": "/run/user/1000/"
   },
   "uid": 1000,
   "expect": {
    "directory": "/run/user/1000/tsm",
    "client": {
     "socket": "/run/user/1000/tsm/client.sock"
    },
    "admin": {
     "socket": "/run/user/1000/tsm/admin.sock"
    }
   }
  },
  {
   "os": "linux",
   "env": {},
   "uid": 1000,
   "expect": {
    "directory": "/tmp/tsm-1000",
    "client": {
     "socket": "/tmp/tsm-1000/client.sock"
    },
    "admin": {
     "socket": "/tmp/tsm-1000/admin.sock"
    }
