{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/statusReport.json",
  "title": "statusReport",
  "description": "The answer to status. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "locked",
    "lockMode",
    "protocol",
    "service",
    "stores",
    "admins",
    "hardening"
  ],
  "properties": {
    "op": {
      "const": "statusReport"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "locked": {
      "type": "boolean"
    },
    "lockMode": {
      "enum": [
        "a",
        "b",
        "c"
      ]
    },
    "protocol": {
      "type": "integer",
      "minimum": 1
    },
    "service": {
      "type": "object",
      "required": [
        "version",
        "start"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "start": {
          "$ref": "common.json#/$defs/epochMs"
        }
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "state",
          "source",
          "notPushed"
        ],
        "properties": {
          "name": {
            "$ref": "common.json#/$defs/storeName"
          },
          "state": {
            "$ref": "common.json#/$defs/storeState"
          },
          "source": {
            "$ref": "common.json#/$defs/source"
          },
          "fetchedAt": {
            "$ref": "common.json#/$defs/timestamp"
          },
          "notPushed": {
            "type": "integer",
            "minimum": 0
          },
          "rewritten": {
            "description": "The branch was rewritten without a compaction: the head of the rewritten branch, until the manager app answers with history.resolve (section 6.4).",
            "type": "object",
            "required": [
              "head"
            ],
            "properties": {
              "head": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "admins": {
      "type": "integer",
      "minimum": 0
    },
    "hardening": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "expiring": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "key",
          "expiresAt",
          "daysLeft"
        ],
        "properties": {
          "kind": {
            "enum": [
              "github_token",
              "vault_keys",
              "approver_key",
              "link_key",
              "github_app"
            ]
          },
          "key": {
            "type": "string"
          },
          "vault": {
            "$ref": "common.json#/$defs/storeName"
          },
          "expiresAt": {
            "$ref": "common.json#/$defs/timestamp"
          },
          "daysLeft": {
            "type": "integer"
          }
        }
      }
    },
    "agent": {
      "description": "[B] The ssh-agent endpoint while it runs (section 7.6).",
      "type": "object",
      "properties": {
        "socket": {
          "type": "string"
        },
        "pipe": {
          "type": "string"
        }
      }
    },
    "github": {
      "description": "[B] The GitHub App sign-in (section 6.3 github.app).",
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_configured",
            "signed_out",
            "pending",
            "signed_in",
            "sign_in_again"
          ]
        },
        "login": {
          "type": "string"
        }
      }
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
