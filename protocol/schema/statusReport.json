{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/statusReport.json",
  "title": "statusReport",
  "description": "The answer to status. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "locked",
    "lockMode",
    "protocol",
    "service",
    "stores",
    "admins",
    "hardening"
  ],
  "properties": {
    "op": {
      "const": "statusReport"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "locked": {
      "type": "boolean"
    },
    "lockMode": {
      "enum": [
        "a",
        "b",
        "c"
      ]
    },
    "protocol": {
      "type": "integer",
      "minimum": 1
    },
    "service": {
      "type": "object",
      "required": [
        "version",
        "start"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "start": {
          "$ref": "common.json#/$defs/epochMs"
        }
      }
    },
    "identity": {
      "description": "The service's identity key (section 6.1).",
      "type": "object",
      "required": [
        "fingerprint",
        "words",
        "since"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "words": {
          "type": "string"
        },
        "since": {
          "$ref": "common.json#/$defs/timestamp"
        },
        "kept": {
          "enum": [
            "keychain",
            "dpapi",
            "system",
            "file"
          ]
        }
      }
    },
    "quickUnlock": {
      "description": "The quick unlock (section 6.4): never a key or a PIN.",
      "type": "object",
      "required": [
        "pin",
        "pinArmed",
        "token",
        "attemptsLeft"
      ],
      "properties": {
        "pin": {
          "type": "boolean"
        },
        "pinArmed": {
          "type": "boolean"
        },
        "token": {
          "type": "boolean"
        },
        "attemptsLeft": {
          "type": "integer",
          "minimum": 0
        },
        "until": {
          "$ref": "common.json#/$defs/timestamp"
        }
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "state",
          "source",
          "notPushed"
        ],
        "properties": {
          "name": {
            "$ref": "common.json#/$defs/storeName"
          },
          "state": {
            "$ref": "common.json#/$defs/storeState"
          },
          "source": {
            "$ref": "common.json#/$defs/source"
          },
          "fetchedAt": {
            "$ref": "common.json#/$defs/timestamp"
          },
          "notPushed": {
            "type": "integer",
            "minimum": 0
          },
          "rewritten": {
            "description": "The branch was rewritten without a compaction: the head of the rewritten branch, until the manager app answers with history.resolve (section 6.4).",
            "type": "object",
            "required": [
              "head"
            ],
            "properties": {
              "head": {
                "type": "string"
              }
            }
          },
          "keyChanged": {
            "description": "[C] Served from a copy under the old key, read-only: another device re-keyed the store and its new key is not listed here yet (section 6.4).",
            "type": "boolean"
          },
          "reason": {
            "description": "Why an unavailable store waits for its remote while no copy of it is held (section 6.3).",
            "enum": [
              "offline",
              "token_expired"
            ]
          }
        }
      }
    },
    "admins": {
      "type": "integer",
      "minimum": 0
    },
    "hardening": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "keepsUnwritten": {
      "description": "While unlocked: whether a save the remote cannot take waits in memory (the offline cache off; section 6.4).",
      "type": "boolean"
    },
    "offlineCacheRemoved": {
      "description": "When this start applied the in-memory default to device settings stored before it and deleted their offline cache.",
      "$ref": "common.json#/$defs/timestamp"
    },
    "expiring": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "key",
          "expiresAt",
          "daysLeft"
        ],
        "properties": {
          "kind": {
            "enum": [
              "github_token",
              "vault_keys",
              "approver_key",
              "link_key",
              "github_app",
              "member_key",
              "certificate",
              "pgp_key"
            ]
          },
          "key": {
            "type": "string"
          },
          "vault": {
            "$ref": "common.json#/$defs/storeName"
          },
          "expiresAt": {
            "$ref": "common.json#/$defs/timestamp"
          },
          "daysLeft": {
            "type": "integer"
          }
        }
      }
    },
    "links": {
      "description": "[C] The approval links while unlocked (section 9.7): the hosts this device approves for and the approvers of this host, with their state.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "device",
          "role",
          "state"
        ],
        "properties": {
          "device": {
            "type": "string"
          },
          "role": {
            "enum": [
              "host",
              "approver"
            ]
          },
          "state": {
            "enum": [
              "connected",
              "waiting",
              "connecting",
              "unreachable"
            ]
          },
          "via": {
            "enum": [
              "address",
              "relay"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "agent": {
      "description": "[B] The ssh-agent endpoint while it runs (section 7.6).",
      "type": "object",
      "properties": {
        "socket": {
          "type": "string"
        },
        "pipe": {
          "type": "string"
        }
      }
    },
    "github": {
      "description": "[B] The GitHub App sign-in (section 6.3 github.app).",
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_configured",
            "signed_out",
            "pending",
            "signed_in",
            "sign_in_again"
          ]
        },
        "login": {
          "type": "string"
        }
      }
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
