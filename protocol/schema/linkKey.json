{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/al-the-bear/tom_secrets_clients/protocol/schema/linkKey.json",
  "title": "linkKey",
  "description": "The sender's new approval-link public key. Endpoint: link; direction: both; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "device",
    "x25519",
    "mlKem768"
  ],
  "properties": {
    "op": {
      "const": "linkKey"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "device": {
      "type": "string"
    },
    "x25519": {
      "$ref": "common.json#/$defs/base64_32"
    },
    "mlKem768": {
      "description": "1,184 bytes, standard base64.",
      "$ref": "common.json#/$defs/base64"
    }
  },
  "x-tsm": {
    "endpoint": "link",
    "direction": "both",
    "phase": "A"
  }
}
