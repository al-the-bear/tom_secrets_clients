{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/grants.revoke.json",
  "title": "grants.revoke",
  "description": "Revoke a grant of any host. Endpoint: admin; direction: a2s; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "host",
    "grantId"
  ],
  "properties": {
    "op": {
      "const": "grants.revoke"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "host": {
      "type": "string"
    },
    "grantId": {
      "type": "string"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "a2s",
    "phase": "A"
  }
}
