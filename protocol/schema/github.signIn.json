{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/github.signIn.json",
  "title": "github.signIn",
  "description": "Start the GitHub App's device flow. Endpoint: admin; direction: a2s; phase B. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id"
  ],
  "properties": {
    "op": {
      "const": "github.signIn"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "clientId": {
      "type": "string"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "a2s",
    "phase": "B"
  }
}
