{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/compacted.json",
  "title": "compacted",
  "description": "The answer to compact. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "repository",
    "compacted",
    "oldHead",
    "newHead",
    "kept"
  ],
  "properties": {
    "op": {
      "const": "compacted"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "repository": {
      "type": "string"
    },
    "compacted": {
      "type": "boolean"
    },
    "oldHead": {
      "type": "string"
    },
    "newHead": {
      "type": "string"
    },
    "kept": {
      "type": "integer",
      "minimum": 0
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
