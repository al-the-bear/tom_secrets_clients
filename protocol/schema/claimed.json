{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/claimed.json",
  "title": "claimed",
  "description": "The new admin key after a successful claim. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "adminKey"
  ],
  "properties": {
    "op": {
      "const": "claimed"
    },
    "adminKey": {
      "$ref": "common.json#/$defs/base64_32"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
