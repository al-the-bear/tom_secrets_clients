{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/inboxFile.json",
  "title": "inboxFile",
  "description": "The answer to inbox.read. Endpoint: admin; direction: s2a; phase C. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "store",
    "member",
    "name",
    "revision",
    "bytes"
  ],
  "properties": {
    "op": {
      "const": "inboxFile"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "store": {
      "$ref": "common.json#/$defs/storeName"
    },
    "member": {
      "description": "A member id: the fingerprint of the member key (base32).",
      "type": "string",
      "pattern": "^[a-z2-7]{16,}$"
    },
    "name": {
      "description": "A package name: <date>-<random>.age.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{16}[.]age$"
    },
    "revision": {
      "type": "string"
    },
    "bytes": {
      "$ref": "common.json#/$defs/base64"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "C"
  }
}
