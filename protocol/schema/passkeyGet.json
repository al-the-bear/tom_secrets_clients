{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/passkeyGet.json",
  "title": "passkeyGet",
  "description": "A sign-in signed with the passkey picked. Endpoint: client; direction: c2s; phase C. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "url",
    "rpId",
    "entryId",
    "clientDataHash"
  ],
  "properties": {
    "op": {
      "const": "passkeyGet"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "url": {
      "type": "string"
    },
    "rpId": {
      "type": "string"
    },
    "entryId": {
      "type": "string"
    },
    "clientDataHash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$"
    }
  },
  "x-tsm": {
    "endpoint": "client",
    "direction": "c2s",
    "phase": "C"
  }
}
