{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/al-the-bear/tom_secrets_clients/protocol/schema/grantList.json",
  "title": "grantList",
  "description": "The answer to grants.list. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "grants"
  ],
  "properties": {
    "op": {
      "const": "grantList"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/grant"
      }
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
