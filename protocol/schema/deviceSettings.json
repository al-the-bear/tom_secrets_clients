{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/deviceSettings.json",
  "title": "deviceSettings",
  "description": "The answer to settings.get. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "device",
    "cliApprovals",
    "stores"
  ],
  "properties": {
    "op": {
      "const": "deviceSettings"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "device": {
      "description": "The device settings (section 6.3), each member when set.",
      "type": "object"
    },
    "cliApprovals": {
      "type": "boolean"
    },
    "stores": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/storeName"
      }
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
