{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/auth.json",
  "title": "auth",
  "description": "The admin proves it holds the admin key. Endpoint: admin; direction: a2s; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "adminNonce",
    "mac",
    "client"
  ],
  "properties": {
    "op": {
      "const": "auth"
    },
    "adminNonce": {
      "$ref": "common.json#/$defs/base64_32"
    },
    "mac": {
      "$ref": "common.json#/$defs/base64_32"
    },
    "client": {
      "$ref": "common.json#/$defs/clientInfo"
    },
    "features": {
      "description": "The admin features offered (challenge) or taken (auth, claim): `chunked`, chunked members (section 2.7).",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "a2s",
    "phase": "A"
  }
}
