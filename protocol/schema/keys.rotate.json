{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/keys.rotate.json",
  "title": "keys.rotate",
  "description": "Rotate this device's own key pairs (the manager app only). Endpoint: admin; direction: a2s; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id"
  ],
  "properties": {
    "op": {
      "const": "keys.rotate"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "approver": {
      "type": "boolean"
    },
    "link": {
      "type": "boolean"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "a2s",
    "phase": "A"
  }
}
