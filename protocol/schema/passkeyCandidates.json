{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/passkeyCandidates.json",
  "title": "passkeyCandidates",
  "description": "The answer to passkeys: never a key. Endpoint: client; direction: s2c; phase C. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "candidates"
  ],
  "properties": {
    "op": {
      "const": "passkeyCandidates"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entryId",
          "title",
          "userName",
          "credentialId"
        ],
        "properties": {
          "entryId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "credentialId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]*$"
          }
        }
      }
    }
  },
  "x-tsm": {
    "endpoint": "client",
    "direction": "s2c",
    "phase": "C"
  }
}
