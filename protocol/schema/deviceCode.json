{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/deviceCode.json",
  "title": "deviceCode",
  "description": "The answer to github.signIn. Endpoint: admin; direction: s2a; phase B. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "userCode",
    "verificationUri",
    "expiresIn",
    "interval"
  ],
  "properties": {
    "op": {
      "const": "deviceCode"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "userCode": {
      "type": "string"
    },
    "verificationUri": {
      "type": "string"
    },
    "expiresIn": {
      "type": "integer",
      "minimum": 0
    },
    "interval": {
      "type": "integer",
      "minimum": 0
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "B"
  }
}
