{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/relayPut.json",
  "title": "relayPut",
  "description": "The answer to relay.put. Endpoint: admin; direction: s2a; phase C. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "name"
  ],
  "properties": {
    "op": {
      "const": "relayPut"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "description": "A package name: <date>-<random>.age.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{16}[.]age$"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "C"
  }
}
