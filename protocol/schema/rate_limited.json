{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/al-the-bear/tom_secrets_clients/protocol/schema/rate_limited.json",
  "title": "rate_limited",
  "description": "An identity is held back. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "identity",
    "until"
  ],
  "properties": {
    "op": {
      "const": "rate_limited"
    },
    "identity": {
      "$ref": "common.json#/$defs/identity"
    },
    "until": {
      "$ref": "common.json#/$defs/timestamp"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
