{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/inbox.put.json",
  "title": "inbox.put",
  "description": "Put one package into the inbox folder of each member (the manager app only). Endpoint: admin; direction: a2s; phase C. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "store",
    "members",
    "bytes"
  ],
  "properties": {
    "op": {
      "const": "inbox.put"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "store": {
      "$ref": "common.json#/$defs/storeName"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "A member id: the fingerprint of the member key (base32).",
        "type": "string",
        "pattern": "^[a-z2-7]{16,}$"
      }
    },
    "bytes": {
      "$ref": "common.json#/$defs/base64"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "a2s",
    "phase": "C"
  }
}
