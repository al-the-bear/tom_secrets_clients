{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/file.json",
  "title": "file",
  "description": "The start of a getFile answer. Endpoint: client; direction: s2c; phase B. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "name",
    "size"
  ],
  "properties": {
    "op": {
      "const": "file"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    }
  },
  "x-tsm": {
    "endpoint": "client",
    "direction": "s2c",
    "phase": "B"
  }
}
