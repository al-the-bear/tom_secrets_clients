{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/approval_needed.json",
  "title": "approval_needed",
  "description": "A request needs an approval. Endpoint: admin, link; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "approvalId",
    "host",
    "identity",
    "refs",
    "resolved"
  ],
  "properties": {
    "op": {
      "const": "approval_needed"
    },
    "approvalId": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "identity": {
      "$ref": "common.json#/$defs/identity"
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/reference"
      }
    },
    "resolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "store",
          "path",
          "kind"
        ],
        "properties": {
          "store": {
            "$ref": "common.json#/$defs/storeName"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "hostHint": {
      "type": "string"
    },
    "approvalCode": {
      "type": "string",
      "pattern": "^[A-Z2-7]{10}$"
    },
    "wantClientToken": {
      "type": "boolean"
    },
    "ssh": {
      "description": "[B] An ssh-agent signature: the key, the destination, the purpose (section 7.6).",
      "type": "object",
      "required": [
        "key",
        "keyType",
        "forwarded",
        "purpose"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "keyType": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "hostNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forwarded": {
          "type": "boolean"
        },
        "purpose": {
          "enum": [
            "userauth",
            "sshsig",
            "other"
          ]
        },
        "namespace": {
          "type": "string"
        }
      }
    },
    "confirmOnly": {
      "description": "[B] A confirmation of one ssh-agent signature a grant allows: answered once or never, nothing written (section 7.6).",
      "type": "boolean"
    },
    "pick": {
      "description": "[B] A helper's pick prompt: the logins to pick from (section 5.5).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entryId",
          "title",
          "userName",
          "matchedUrl"
        ],
        "properties": {
          "entryId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "matchedUrl": {
            "type": "string"
          }
        }
      }
    },
    "url": {
      "description": "[B] The page or host the logins of a pick or browser prompt match.",
      "type": "string"
    },
    "browser": {
      "description": "[B] A browser prompt: the browser host asks for the logins of the page `url`; a lasting answer names the browser (`exe-from`, section 5.5).",
      "type": "boolean"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A",
    "alsoOn": [
      "link"
    ]
  }
}
