{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/al-the-bear/tom_secrets_clients/protocol/schema/end.json",
  "title": "end",
  "description": "The end of a getFile answer, after its binary chunks. Endpoint: client; direction: s2c; phase B. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "sha256"
  ],
  "properties": {
    "op": {
      "const": "end"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "x-tsm": {
    "endpoint": "client",
    "direction": "s2c",
    "phase": "B"
  }
}
