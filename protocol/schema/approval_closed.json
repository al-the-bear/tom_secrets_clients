{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/al-the-bear/tom_secrets_clients/protocol/schema/approval_closed.json",
  "title": "approval_closed",
  "description": "A prompt was answered or ended elsewhere. Endpoint: admin, link; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "approvalId",
    "outcome"
  ],
  "properties": {
    "op": {
      "const": "approval_closed"
    },
    "approvalId": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "approved",
        "denied",
        "timeout",
        "abandoned",
        "no_approver"
      ]
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A",
    "alsoOn": [
      "link"
    ]
  }
}
