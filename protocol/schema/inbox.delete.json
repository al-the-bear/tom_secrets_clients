{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/inbox.delete.json",
  "title": "inbox.delete",
  "description": "Delete packages from the inbox folders: imported, declined or expired (the manager app only). Endpoint: admin; direction: a2s; phase C. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "store",
    "files"
  ],
  "properties": {
    "op": {
      "const": "inbox.delete"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "store": {
      "$ref": "common.json#/$defs/storeName"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "member",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "member": {
            "description": "A member id: the fingerprint of the member key (base32).",
            "type": "string",
            "pattern": "^[a-z2-7]{16,}$"
          },
          "name": {
            "description": "A package name: <date>-<random>.age.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{16}[.]age$"
          }
        }
      }
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "a2s",
    "phase": "C"
  }
}
