{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/tokenSet.json",
  "title": "tokenSet",
  "description": "The answer to token.set. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "repository",
    "where"
  ],
  "properties": {
    "op": {
      "const": "tokenSet"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "repository": {
      "type": "string"
    },
    "where": {
      "enum": [
        "keychain",
        "primary"
      ]
    },
    "expiresAt": {
      "type": "string"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
