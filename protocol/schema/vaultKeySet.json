{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/vaultKeySet.json",
  "title": "vaultKeySet",
  "description": "The answer to vaultKeys. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "stores"
  ],
  "properties": {
    "op": {
      "const": "vaultKeySet"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "unserved": {
      "description": "The further vaults the primary lists that this machine does not serve (section 6.4): editable by name, never served to clients.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "store",
          "location"
        ],
        "properties": {
          "store": {
            "$ref": "common.json#/$defs/storeName"
          },
          "location": {
            "type": "string"
          }
        }
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "store",
          "location",
          "keys"
        ],
        "properties": {
          "store": {
            "$ref": "common.json#/$defs/storeName"
          },
          "location": {
            "type": "string"
          },
          "served": {
            "description": "false for a vault this machine does not serve, opened for editing only (section 6.4).",
            "type": "boolean"
          },
          "keys": {
            "description": "The store key material (section 6.4): its master password, key file and repository outer key, each when the store has one; for a vault opened with an OS unlock bundle (phase B) its composite key in place of the password and the key file.",
            "type": "object",
            "properties": {
              "password": {
                "type": "string"
              },
              "keyFile": {
                "$ref": "common.json#/$defs/base64"
              },
              "outerKey": {
                "$ref": "common.json#/$defs/base64"
              },
              "compositeKey": {
                "$ref": "common.json#/$defs/base64_32"
              }
            }
          }
        }
      }
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
