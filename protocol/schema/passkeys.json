{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/passkeys.json",
  "title": "passkeys",
  "description": "The passkeys of a page (browser host). Endpoint: client; direction: c2s; phase C. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "url",
    "rpId"
  ],
  "properties": {
    "op": {
      "const": "passkeys"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "url": {
      "type": "string"
    },
    "rpId": {
      "type": "string"
    },
    "allowCredentials": {
      "description": "Only these credential ids (base64url).",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]*$"
      }
    },
    "wait": {
      "type": "boolean"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "x-tsm": {
    "endpoint": "client",
    "direction": "c2s",
    "phase": "C"
  }
}
