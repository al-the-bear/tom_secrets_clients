{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/relay.list.json",
  "title": "relay.list",
  "description": "The files below a folder below relay/ (the manager app only). Endpoint: admin; direction: a2s; phase C. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "store",
    "folder"
  ],
  "properties": {
    "op": {
      "const": "relay.list"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "store": {
      "$ref": "common.json#/$defs/storeName"
    },
    "folder": {
      "description": "A path below the relay folder of the repository: relay/...",
      "type": "string",
      "pattern": "^relay(/[A-Za-z0-9][A-Za-z0-9._-]*)+$"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "a2s",
    "phase": "C"
  }
}
