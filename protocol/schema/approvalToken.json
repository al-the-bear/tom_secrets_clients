{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/approvalToken.json",
  "title": "approvalToken",
  "description": "The answer to approval.issue. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "token"
  ],
  "properties": {
    "op": {
      "const": "approvalToken"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Z2-7]{26}$"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
