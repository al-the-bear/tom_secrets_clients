{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/save.json",
  "title": "save",
  "description": "Hand an edited store file to the service to write. Endpoint: admin; direction: a2s; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "store",
    "bytes"
  ],
  "properties": {
    "op": {
      "const": "save"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "store": {
      "$ref": "common.json#/$defs/storeName"
    },
    "bytes": {
      "$ref": "common.json#/$defs/base64"
    },
    "baseRevision": {
      "type": "string"
    },
    "keys": {
      "description": "The primary's new keys when its file is re-keyed (section 6.4).",
      "type": "object",
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "type": "string"
        },
        "keyFile": {
          "$ref": "common.json#/$defs/base64"
        },
        "outerKey": {
          "$ref": "common.json#/$defs/base64"
        }
      }
    },
    "recipients": {
      "description": "[C] A shared vault's recipients file (an age file), written beside the re-keyed vault in the same commit: a member removed (section 6.4); only with a re-keyed save.",
      "$ref": "common.json#/$defs/base64"
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "a2s",
    "phase": "A"
  }
}
