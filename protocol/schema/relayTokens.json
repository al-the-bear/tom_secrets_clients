{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/relayTokens.json",
  "title": "relayTokens",
  "description": "The answer to relay.token.list; never a token. Endpoint: admin; direction: s2a; phase C. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "relays"
  ],
  "properties": {
    "op": {
      "const": "relayTokens"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "relays": {
      "description": "Each relay asked: whether a token is kept.",
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "C"
  }
}
