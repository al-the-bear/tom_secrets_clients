{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/al-the-bear/tom_secrets_clients/protocol/schema/vaultKeys.json",
  "title": "vaultKeys",
  "description": "Get the keys of the open vaults for editing. Endpoint: admin; direction: a2s; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id"
  ],
  "properties": {
    "op": {
      "const": "vaultKeys"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "stores": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/storeName"
      }
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "a2s",
    "phase": "A"
  }
}
