{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/store_state.json",
  "title": "store_state",
  "description": "A store changed state. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "store",
    "state",
    "source",
    "notPushed"
  ],
  "properties": {
    "op": {
      "const": "store_state"
    },
    "store": {
      "$ref": "common.json#/$defs/storeName"
    },
    "state": {
      "$ref": "common.json#/$defs/storeState"
    },
    "source": {
      "$ref": "common.json#/$defs/source"
    },
    "fetchedAt": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "notPushed": {
      "type": "integer",
      "minimum": 0
    },
    "rewritten": {
      "description": "The branch was rewritten without a compaction: the head of the rewritten branch, until the manager app answers with history.resolve (section 6.4).",
      "type": "object",
      "required": [
        "head"
      ],
      "properties": {
        "head": {
          "type": "string"
        }
      }
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
