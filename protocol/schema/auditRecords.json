{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/al-the-bear/tom_secrets_clients/main/protocol/schema/auditRecords.json",
  "title": "auditRecords",
  "description": "The answer to audit.query. Endpoint: admin; direction: s2a; phase A. Unknown members are ignored by the reader (protocol.md section 8).",
  "type": "object",
  "required": [
    "op",
    "id",
    "records"
  ],
  "properties": {
    "op": {
      "const": "auditRecords"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "host",
          "identity",
          "refs",
          "outcome"
        ],
        "properties": {
          "time": {
            "$ref": "common.json#/$defs/timestamp"
          },
          "host": {
            "type": "string"
          },
          "identity": {
            "$ref": "common.json#/$defs/identity"
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "common.json#/$defs/reference"
            }
          },
          "outcome": {
            "description": "\"allowed\", \"denied:<reason>\", an error kind, or for a lookup \"matched\" / \"proposed\".",
            "type": "string"
          },
          "grantId": {
            "type": "string"
          },
          "approver": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ssh": {
            "description": "[B] An ssh-agent signature: the key, the destination, the purpose (section 7.6).",
            "type": "object",
            "required": [
              "key",
              "keyType",
              "forwarded",
              "purpose"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "keyType": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "host": {
                "type": "string"
              },
              "hostNames": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "forwarded": {
                "type": "boolean"
              },
              "purpose": {
                "enum": [
                  "userauth",
                  "sshsig",
                  "other"
                ]
              },
              "namespace": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "x-tsm": {
    "endpoint": "admin",
    "direction": "s2a",
    "phase": "A"
  }
}
